{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "PLAYWRIGHT_*",
        "NEXT_PUBLIC_*",
        "STRAPI_INTERNAL_URL",
        "DATABASE_*",
        "POSTGRES_*",
        "REDIS_*"
      ]
    },
    "e2e:smoke": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "PLAYWRIGHT_*",
        "NEXT_PUBLIC_*",
        "STRAPI_INTERNAL_URL",
        "DATABASE_*",
        "POSTGRES_*",
        "REDIS_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "develop": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  }
}
