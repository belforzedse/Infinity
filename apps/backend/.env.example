HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database Configuration
POSTGRES_IMAGE=postgres:16-alpine
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=infinity_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strapi_password
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT=30000

# Redis Configuration
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redispass
REDIS_CACHE_DB=1
REST_CACHE_PROVIDER=redis
REST_CACHE_REDIS_CONNECTION=default

# Endpoint response cache (conservative rollout)
ENABLE_ENDPOINT_RESPONSE_CACHE=true
CACHE_ONLY_ANONYMOUS=true
CACHE_TTL_PRODUCT_BY_SLUG_SEC=60
CACHE_TTL_PRODUCT_SEARCH_SEC=20
CACHE_TTL_BLOG_SLUG_SEC=120
CACHE_TTL_BLOG_COMMENTS_SEC=60
CACHE_DEBUG_HEADER=false

# Async view counters (eventual consistency)
ENABLE_ASYNC_VIEW_COUNTERS=true
VIEW_COUNTER_FLUSH_INTERVAL_MS=60000
VIEW_COUNTER_BUCKET_SEC=60

# SMS Gateway (IP Panel)
IP_PANEL_API_URL=https://api2.ippanel.com/api/v1/sms/pattern/normal/send
IP_PANEL_API_KEY=your_api_key_here
IP_PANEL_PATTERN_CODE=0gmadbsu7h1ozf1
IP_PANEL_SENDER=+983000505

# Payment Gateway - Mellat Bank (REQUIRED)
MELLAT_TERMINAL_ID=your_terminal_id
MELLAT_USERNAME=your_username
MELLAT_PASSWORD=your_password
MELLAT_GATEWAY_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw
MELLAT_PAYMENT_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat

# Payment Gateway - SnappPay (REQUIRED)
SNAPPAY_BASE_URL=https://api.snappay.ir
SNAPPAY_CLIENT_ID=your_client_id
SNAPPAY_CLIENT_SECRET=your_client_secret
SNAPPAY_USERNAME=your_username
SNAPPAY_PASSWORD=your_password
SNAPPAY_RETURN_URL=http://localhost:1337/api/orders/payment-callback

# Payment Gateway - Saman Kish / SEP (REQUIRED for wallet top-ups)
SAMAN_GATEWAY_URL=https://sep.shaparak.ir/onlinepg/onlinepg
SAMAN_PAYMENT_PAGE_URL=https://sep.shaparak.ir/OnlinePG/OnlinePG
SAMAN_SEND_TOKEN_URL=https://sep.shaparak.ir/OnlinePG/SendToken
SAMAN_VERIFY_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction
SAMAN_REVERSE_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/ReverseTransaction
SAMAN_TERMINAL_ID=your_terminal_id
SAMAN_USERNAME=your_username
SAMAN_PASSWORD=your_password
SAMAN_CALLBACK_URL=https://api.infinitycolor.co/api/wallet/payment-callback
SAMAN_TOKEN_EXPIRY_MIN=20

# Revalidation Secret (REQUIRED for blog post cache invalidation)
REVALIDATION_SECRET=your_revalidation_secret_here

# Matomo Analytics (GA4 alternative)
MATOMO_BASE_URL=https://analytics.example.com
MATOMO_SITE_ID=1
MATOMO_API_TOKEN=your_matomo_api_token
MATOMO_TIMEOUT_MS=8000
TRAFFIC_DASHBOARD_CACHE_TTL_MS=30000
TRAFFIC_REALTIME_CACHE_TTL_MS=10000

# Sentry/Bugsink Error Tracking (optional - leave empty to disable)
SENTRY_DSN=
