{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Posts",
    "description": "Media posts with optional product links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "Slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 150
    },
    "Description": {
      "type": "richtext",
      "required": true
    },
    "CoverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "ProductLink": {
      "type": "string",
      "maxLength": 500
    },
    "Size": {
      "type": "enumeration",
      "enum": [
        "Small",
        "Medium",
        "Large",
        "X Large"
      ],
      "required": true
    },
    "post_likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-like.post-like",
      "mappedBy": "post"
    },
    "post_bookmarks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-bookmark.post-bookmark",
      "mappedBy": "post"
    },
    "post_comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-comment.post-comment",
      "mappedBy": "post"
    }
  }
}
