{
  "kind": "collectionType",
  "collectionName": "post_comments",
  "info": {
    "singularName": "post-comment",
    "pluralName": "post-comments",
    "displayName": "Post Comment",
    "description": "Threaded comments on posts with moderation support"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Content": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "Status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true
    },
    "Date": {
      "type": "datetime",
      "required": true
    },
    "Name": {
      "type": "string",
      "required": false,
      "maxLength": 150
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "post": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::post.post",
      "inversedBy": "post_comments"
    },
    "parent_comment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::post-comment.post-comment",
      "inversedBy": "replies"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-comment.post-comment",
      "mappedBy": "parent_comment"
    },
    "post_comment_likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-comment-like.post-comment-like",
      "mappedBy": "post_comment"
    }
  }
}
