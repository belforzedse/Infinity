# API Configuration — see dev.env.example for local storefront setup (Strapi on port 1337)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337/
# Server-side only. In Docker production this should point to the internal Nginx
# listener that proxies to strapi_upstream, e.g. http://host.docker.internal:8080/api
STRAPI_INTERNAL_URL=

# SSG Configuration (0 to disable, number for limit)
NEXT_PUBLIC_MAX_BLOG_SSG=0
NEXT_PUBLIC_MAX_PDP_SSG=0

# Sentry/Bugsink Error Tracking (optional - leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
