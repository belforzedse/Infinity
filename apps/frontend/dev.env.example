# Local storefront — copy to dev.env or .env.local (both gitignored)
# Strapi (@repo/backend) must be running on port 1337 before starting the frontend.

NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337/
NEXT_PUBLIC_STRAPI_TOKEN=

# Optional: use staging/production API instead of local Strapi
# NEXT_PUBLIC_API_BASE_URL=https://api.infinity.rgbgroup.ir/api
# NEXT_PUBLIC_IMAGE_BASE_URL=https://api.infinity.rgbgroup.ir/

# Server-side only (Docker production). Leave empty for local dev.
STRAPI_INTERNAL_URL=
