# Infinity Store Monorepo .gitignore

############################
# Dependencies
############################

node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

############################
# Environment Files
############################

.env
.env.local
.env.*.local
*.env
!*.env.example
main.env
dev.env
db.env

# Secrets
SECRETS_REFERENCE.txt

############################
# Build Outputs
############################

# Next.js
/.next/
/out/
apps/frontend/.next/
apps/frontend/out/
.turbo/

# Strapi
dist/
build/
.strapi/
.strapi-updater.json
.strapi-cloud.json
apps/backend/dist/
apps/backend/build/
apps/backend/.tmp/

# Production
/build

############################
# Logs
############################

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

############################
# OS Files
############################

.DS_Store
.AppleDouble
.LSOverride
Icon
.Spotlight-V100
.Trashes
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

############################
# IDE
############################

.idea/
.vscode/
*.swp
*.swo
*.swn
*.swm

############################
# Testing
############################

coverage/
.nyc_output/
/coverage
apps/e2e/playwright-report/
apps/e2e/test-results/
apps/e2e/e2e-results.xml
apps/e2e/.auth/

############################
# TypeScript
############################

*.tsbuildinfo
next-env.d.ts

############################
# Temporary Files
############################

*.tmp
temp/
.tmp

############################
# Python
############################

.venv/
apps/backend/scripts/orders-to-pdf/.venv/

############################
# Misc
############################

*.pid
*.seed
*.pid.lock
.vercel
ssl/
nbproject/
public/uploads/*
!public/uploads/.gitkeep
nul

# Generated files
apps/frontend/src/constants/build-version.json

# Lock files (optional - uncomment to ignore)
# yarn.lock
# package-lock.json


